# Variables d'environnement pour Anoria City Builder
# Ficher d'example à copier dans un fichier .env

# Activer/désactiver les objectifs du jeu
# true = activés (défaut), false = désactivés
VITE_IS_GOAL=false
VITE_IS_EVENTS_TEST=false
VITE_IS_EVENTS=false
# Jours (tours) par mois : valeur par défaut de la partie. Le joueur peut la changer avant de lancer la
# partie (paramètres de la page d'accueil) ; elle est ensuite figée pour toute la partie.
VITE_DAYS_PER_MONTH=5
VITE_IS_LOSE_MODE=false
# true = déblocage progressif des bâtiments (skills / level-2)
# false = tous les bâtiments placeables sont disponibles
VITE_IS_EVOL_MODE=false